{
  "name": "@deepseek-ai/dsh-browser-use-playwright-bundle",
  "description": "Optional Playwright browser composition: Chromium pages, recording, and step-by-step automation for each Session",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/browser-use-playwright-bundle"
  },
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/dsh-browser-use": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin",
        "win32",
        "linux"
      ]
    }
  }
}
